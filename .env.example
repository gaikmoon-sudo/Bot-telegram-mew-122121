# Required
BOT_TOKEN=your-telegram-bot-token

# PostgreSQL runtime database
DATABASE_URL=postgresql://user:password@host:5432/academy
# Use Replit App Storage in Replit deployments; use local only for development.
CONTENT_STORAGE_BACKEND=replit
# Optional: omit to use the app's default Replit App Storage bucket.
APP_STORAGE_BUCKET_ID=
# Required Redis URL for FSM and cache
REDIS_URL=redis://redis:6379/0
# Comma-separated Telegram numeric user IDs with admin access.
ADMIN_IDS=123456789

# Optional Sentry monitoring

# Required public HTTPS endpoint for Telegram updates. On Replit you can use the public deployment domain.
WEBHOOK_URL=https://your-replit-deployment-domain/telegram/webhook
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-this-secret
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Public HTTPS URL used by Telegram Web App.
# On Replit, WEB_APP_URL can be your public *.replit.dev / deployment URL.
WEB_APP_URL=
# External Piston code execution API
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
PISTON_TIMEOUT_SECONDS=15
PISTON_COMPILE_TIMEOUT_MS=5000
PISTON_RUN_TIMEOUT_MS=3000
PISTON_MAX_CONCURRENCY=4
PISTON_MAX_CODE_CHARS=20000
PISTON_MAX_STDIN_CHARS=5000
PISTON_MAX_OUTPUT_CHARS=12000
# AI Tutor (keep disabled until the API key is configured)
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
AI_TUTOR_DAILY_LIMIT=10
AI_REVIEW_DAILY_LIMIT=3
AI_QUIZ_DAILY_LIMIT=1

# AI response cache (Redis, best-effort; 0 disables caching)
AI_CACHE_TTL=86400

# Sentry observability (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production_replit


# IANA timezone used by daily reminders and streak dates
APP_TIMEZONE=UTC
# Contact buttons (Telegram usernames without @)
REPRESENTATIVE_USERNAME=alialgadiri
DEVELOPER_USERNAME=Dark6j1
ADMIN_USERNAME=Dark6j1
