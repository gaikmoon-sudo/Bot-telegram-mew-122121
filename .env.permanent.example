# Telegram
BOT_TOKEN=replace_with_botfather_token
ADMIN_IDS=replace_with_your_telegram_numeric_id

# Public HTTPS domain - required for Telegram webhook and Web Apps
WEBHOOK_URL=https://your-domain.example/telegram/webhook
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_long_random_secret
WEB_APP_URL=https://your-domain.example
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Docker deployment database (replace all placeholders before starting)
POSTGRES_USER=academy
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=academy
DATABASE_URL=postgresql://academy:replace_with_strong_database_password@db:5432/academy

# Redis password must be URL-safe, or percent-encode special characters in REDIS_URL
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0

# Local backend is persistent because Compose mounts /app/data.
# Replit deployments must use CONTENT_STORAGE_BACKEND=replit instead.
CONTENT_STORAGE_BACKEND=local

# Keep disabled until configured and tested
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=replace_with_a_verified_model_id
OPENAI_API_KEY=
AI_TUTOR_DAILY_LIMIT=10
AI_REVIEW_DAILY_LIMIT=3
AI_QUIZ_DAILY_LIMIT=1
AI_CACHE_TTL=86400

# Optional
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
APP_TIMEZONE=UTC
SENTRY_DSN=
# production_docker permits the persistent local content volume.
SENTRY_ENVIRONMENT=production_docker
REPRESENTATIVE_USERNAME=
DEVELOPER_USERNAME=
ADMIN_USERNAME=
